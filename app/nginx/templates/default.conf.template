# nginx 공식 이미지가 기동할 때 ${DOMAIN} 만 치환해 /etc/nginx/conf.d/default.conf 로 만든다

# 로그인 API: IP당 분당 10회
limit_req_zone $binary_remote_addr zone=login:10m rate=10r/m;

# maria 컨테이너가 재생성돼 IP가 바뀌어도 따라가게 Docker DNS로 매 요청 조회
resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen 80;
    server_name ${DOMAIN};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000" always;
    server_tokens off;
    client_max_body_size 10m;

    set $maria http://maria:10000;

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # 경로 우회 시도(.., 인코딩된 . / \) 차단
    if ($request_uri ~* "(\.\.|%2e|%2f|%5c)") {
        return 400;
    }

    # 헬스체크는 서버 안에서만 쓴다
    location /actuator/ {
        return 404;
    }

    # 2차 고객 API: 공개
    location /api/customer/ {
        proxy_pass $maria;
    }

    # 관리자 로그인: IP 허용 목록 + 횟수 제한
    location = /api/auth/admin/login {
        include /etc/nginx/admin-allowlist.conf;
        deny all;
        limit_req zone=login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass $maria;
    }

    # 그 밖의 관리자 화면·API: IP 허용 목록
    location / {
        include /etc/nginx/admin-allowlist.conf;
        deny all;
        proxy_pass $maria;
    }
}
